<root>
	<windowclass name="charsheet_overview" merge="join">
		<sheetdata>
			<button_checkbox name="forceuser">
				<anchored width="20" height="20">
					<top parent="name" anchor="below" offset="10" />
					<left parent="name" anchor="below" offset="20" />
				</anchored>
				<tooltip text="Is this character a Force user?" />
				<script>
				</script>
			</button_checkbox>
			<stringcontrol name="labelforceuser">
				<anchored to="forceuser" height="30">
					<top offset="-5" />
					<left parent="forceuser" anchor="right" offset="5" />
				</anchored>
				<static>
					<textres>label_force_sensitive</textres>
				</static>
			</stringcontrol>


			<number_listitem_left name="characterpoints">
				<anchored to="labelforceuser" width="30">
					<top offset="5" />
					<left parent="labelforceuser" anchor="right" offset="10" />
				</anchored>
				<script>
				</script>
			</number_listitem_left>
			<stringcontrol name="labelcharacterpoint">
				<anchored to="characterpoints" height="30" >
					<top offset="-5" />
					<left anchor="right" offset="5" />
				</anchored>
				<static>
					<textres>char_label_charpoints</textres>
				</static>
			</stringcontrol>

			<number_listitem_left name="forcepoints">
				<anchored to="labelcharacterpoint" width="30" >
					<top offset="5" />
					<left offset="10" />
				</anchored>
				<script></script>
			</number_listitem_left>
			<stringcontrol name="labelforcepoint">
				<anchored to="forcepoints" height="30"  >
					<top offset="-5" />
					<left anchor="right" offset="5" />
				</anchored>
				<static>
					<textres>label_character_sheet_force_points</textres>
				</static>
			</stringcontrol>

			<number_listitem_left name="darksidepoints">
				<anchored to="labelforcepoint" width="30">
					<top offset="5" />
					<left offset="10" />
				</anchored>
				<script></script>
			</number_listitem_left>
			<stringcontrol name="labeldsrksidepoint">
				<anchored to="darksidepoints" height="30" >
					<top offset="-5" />
					<left anchor="right" offset="5" />
				</anchored>
				<static>
					<textres>label_character_sheet_dark_side_points</textres>
				</static>
			</stringcontrol>

			<number_listitem_left name="movement">
				<anchored to="labeldsrksidepoint" width="30">
					<top offset="5" />
					<left offset="10" />
				</anchored>
			</number_listitem_left>
			<stringcontrol name="labelmovement">
				<anchored to="movement" height="30" >
					<top offset="-5" />
					<left anchor="right" offset="5" />
				</anchored>
				<static>
					<textres>label_character_sheet_movement</textres>
				</static>
			</stringcontrol>
		</sheetdata>
	</windowclass>
</root>