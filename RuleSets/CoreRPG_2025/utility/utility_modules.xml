<root>
	<template name="modulepermissioncontrol">
		<genericcontrol>
			<anchored width="30" height="30" />
			<cursor hover="hand" />
			<gmvisibleonly />
			<script>
				function onInit()
					if permissions[1] == "allow" then
						registerMenuItem(Interface.getString("modulepermission_menu_allowall"), "windowshare", 3);
						registerMenuItem(Interface.getString("modulepermission_menu_allowallconfirm"), "windowshare", 3, 3);
					elseif permissions[1] == "disallow" then
						registerMenuItem(Interface.getString("modulepermission_menu_disallowall"), "windowunshare", 3);
						registerMenuItem(Interface.getString("modulepermission_menu_disallowallconfirm"), "windowunshare", 3, 3);
					end
				end
				function onMenuSelection(selection, subselection)
					if selection == 3 and subselection == 3 then
						WindowManager.callOuterWindowFunction(window, "setPermissions", permissions[1]);
					end
				end
				function onDragStart(button, x, y, draginfo)
					draginfo.setType("modulepermissions");
					draginfo.setStringData(permissions[1]);
					draginfo.setIcon(icon[1]);
					setIcon(nil);
					return true;
				end
				function onDragEnd(draginfo)
					setIcon(icon[1]);
				end
			</script>
		</genericcontrol>
	</template>

	<windowclass name="moduleselection">
		<frame>utilitybox</frame>
		<sizelimits>
			<minimum width="700" height="600" />
			<maximum width="1600" height="1000" />
			<dynamic />
		</sizelimits>
		<helplinkres>help_tool_moduleselection</helplinkres>
		<script file="utility/scripts/moduleselection.lua" />
		<sheetdata>
			<windowtitlebar_utilitybox name="title" />
			<windowmenubar_utilitybox name="menubar" />

			<anchor_content_utilitybox_top />
			<anchor_content_utilitybox_bottom />

			<sub_content_bottom name="sub_filter">
				<class>moduleselection_filter</class>
			</sub_content_bottom>
			<sub_content_paging />

			<list_content_framed_groupbox name="list">
				<class>moduleselection_entry</class>
				<columns width="300" fillwidth="true" />
			</list_content_framed_groupbox>
			<scrollbar_content_list />

			<resize_utilitybox />
		</sheetdata>
	</windowclass>
	<windowclass name="moduleselection_filter">
		<sheetdata>
			<anchor_content_top />

			<filter_content_top_left name="filter_name">
				<empty textres="module_empty_filter_name" />
				<script>
					function onValueChanged()
						super.onValueChanged();
						WindowManager.callOuterWindowFunction(window, "onNameFilterChanged");
					end
				</script>
			</filter_content_top_left>
			<filter_content_top_right name="filter_author">
				<empty textres="module_empty_filter_author" />
				<script>
					function onValueChanged()
						super.onValueChanged();
						WindowManager.callOuterWindowFunction(window, "onAuthorFilterChanged");
					end
				</script>
			</filter_content_top_right>

			<spacer_content_top name="spacer_buttons" />

			<area_content_top name="area_button">
				<anchored height="30" />
			</area_content_top>

			<button_text name="module_sets">
				<anchored to="area_button" position="insidetopleft" offset="30,5" width="100" />
				<state textres="module_sets" />
				<script>
					function onButtonPress()
						Interface.openWindow("module_sets", "");
					end
				</script>
			</button_text>

			<modulepermissioncontrol name="button_disallow">
				<anchored to="module_sets" position="righthigh" offset="30,-5" />
				<icon>module_stateblocked</icon>
				<permissions>disallow</permissions>
				<tooltip textres="module_block" />
			</modulepermissioncontrol>
			<modulepermissioncontrol name="button_allow">
				<anchored to="button_disallow" position="righthigh" offset="0,0" />
				<icon>module_stateallowed</icon>
				<permissions>allow</permissions>
				<tooltip textres="module_allow" />
			</modulepermissioncontrol>
			<modulepermissioncontrol name="button_autoload">
				<anchored to="button_allow" position="righthigh" offset="0,0" />
				<icon>module_stateautoload</icon>
				<permissions>autoload</permissions>
				<tooltip textres="module_autoload" />
			</modulepermissioncontrol>

			<genericcontrol name="rightanchor">
				<anchored to="area_button" position="insidetopright" offset="20,5" width="0" height="20" />
				<disabled />
			</genericcontrol>
			<button_text name="filter_loaded">
				<anchored to="rightanchor" width="100">
					<top />
					<right anchor="left" relation="relative" offset="-10" postoffset="-10" />
				</anchored>
				<state textres="module_label_filter_loaded_any" merge="add" />
				<state textres="module_label_filter_loaded_on" merge="add" />
				<state textres="module_label_filter_loaded_off" merge="add" />
				<script>
					function onValueChanged()
						WindowManager.callOuterWindowFunction(window, "onLoadedFilterChanged");
					end
				</script>
			</button_text>
			<button_text name="filter_shared">
				<anchored to="rightanchor" width="100">
					<top />
					<right anchor="left" relation="relative" offset="-10" postoffset="-10" />
				</anchored>
				<state textres="module_label_filter_shared_any" merge="add" />
				<state textres="module_label_filter_shared_on" merge="add" />
				<state textres="module_label_filter_shared_off" merge="add" />
				<invisible />
				<script>
					function onValueChanged()
						WindowManager.callOuterWindowFunction(window, "onSharedFilterChanged");
					end
				</script>
			</button_text>
			<button_text name="filter_ruleset">
				<anchored to="rightanchor" width="100">
					<top />
					<right anchor="left" relation="relative" offset="-10" postoffset="-10" />
				</anchored>
				<state textres="module_label_filter_ruleset_any" merge="add" />
				<state textres="module_label_filter_ruleset_specific" merge="add" />
				<state textres="module_label_filter_ruleset_generic" merge="add" />
				<script>
					function onValueChanged()
						WindowManager.callOuterWindowFunction(window, "onRulesetFilterChanged");
					end
				</script>
			</button_text>
		</sheetdata>
	</windowclass>

	<windowclass name="moduleselection_entry">
		<margins control="0,0,0,14" />
		<sizelimits>
			<minimum height="100" />
		</sizelimits>
		<frame>fieldlight</frame>
		<script file="utility/scripts/module_selectionentry.lua" />
		<sheetdata>
			<buttoncontrol name="base">
				<bounds>0,0,-1,-1</bounds>
				<script>
					function onDoubleClick()
						window.toggleActivation();
						return true;
					end
				</script>
			</buttoncontrol>

			<genericcontrol name="thumbnail">
				<bounds>10,20,63,63</bounds>
				<disabled />
			</genericcontrol>
			<stringcontrol name="name">
				<anchored width="210">
					<left offset="80" />
					<top offset="23" />
				</anchored>
				<font>sheetlabel</font>
				<multilinespacing>20</multilinespacing>
				<static />
				<disabled />
			</stringcontrol>
			<stringc_noframe_static name="author">
				<anchored width="210">
					<left offset="80" />
					<top parent="name" anchor="bottom" offset="2" />
				</anchored>
				<multilinespacing>20</multilinespacing>
				<disabled />
			</stringc_noframe_static>
			<genericcontrol name="load">
				<anchored width="40" height="28">
					<left anchor="right" offset="-85" />
					<top parent="author" anchor="bottom" offset="2" />
				</anchored>
				<states>
					<loaded>module_loaded</loaded>
					<unloaded>module_unloaded</unloaded>
					<loading>module_loading</loading>
					<unloading>module_unloading</unloading>
				</states>
				<disabled />
			</genericcontrol>
			<button_text name="button_load">
				<anchored width="60" height="15">
					<right offset="-90" />
					<top parent="author" anchor="bottom" offset="9" />
				</anchored>
				<state textres="module_load" merge="add" />
				<state textres="module_unload" merge="add" />
				<script>
					function onButtonPress()
						window.toggleActivation();
						return true;
					end
				</script>
			</button_text>
			<buttoncontrol name="permissions">
				<anchored width="40" height="31">
					<top parent="load" />
					<left parent="load" anchor="right" offset="-7" />
				</anchored>
				<gmeditonly />
				<gmvisibleonly />
				<state icon="module_stateblocked" tooltipres="module_stateblocked" />
				<state icon="module_stateallowed" tooltipres="module_stateallowed" />
				<state icon="module_stateautoload" tooltipres="module_stateautoload" />
				<script>
					local bBlockUpdate = false;
					function onDrop(x, y, draginfo)
						if draginfo.isType("modulepermissions") then
							window.setPermissions(draginfo.getStringData());
							return true;
						end
						return false;
					end
					function onButtonPress()
						local value = getValue();
						if value == 2 then
							window.setPermissions("autoload");
						elseif value == 1 then
							window.setPermissions("allow");
						else
							window.setPermissions("disallow");
						end
					end
				</script>
			</buttoncontrol>
		</sheetdata>
	</windowclass>

	<windowclass name="module_sets">
		<frame>utilitybox</frame>
		<placement>
			<nosave />
		</placement>
		<sizelimits>
			<minimum width="500" height="650" />
			<dynamic />
		</sizelimits>
		<helplinkres>help_tool_moduleselection</helplinkres>
		<script>
			function onInit()
				for _,v in ipairs(CampaignSetupManager.getModuleSets()) do
					list.createWindow().setData(v);
				end
			end
			function onModuleSetLoad(tData)
				setlist.closeAll();
				for _, tModuleSetItem in ipairs(tData.modules) do
					setlist.createWindow().setData(tModuleSetItem, true);
				end
			end
			function onModuleSetUnload(tData)
				setlist.closeAll();
				for _, tModuleSetItem in ipairs(tData.modules) do
					setlist.createWindow().setData(tModuleSetItem, false);
				end
			end
		</script>
		<sheetdata>
			<windowtitlebar_utilitybox name="title">
				<resource>module_sets</resource>
			</windowtitlebar_utilitybox>
			<windowmenubar_utilitybox name="menubar" />

			<anchor_content_utilitybox_top />
			<anchor_content_utilitybox_bottom />

			<list_content_framed_groupbox_bottom name="setlist">
				<anchored height="300" />
				<class>module_set_load_entry</class>
			</list_content_framed_groupbox_bottom>
			<scrollbar_content_base>
				<anchored to="setlist" />
				<target>setlist</target>
			</scrollbar_content_base>

			<list_content_framed_groupbox name="list">
				<class>module_set_entry</class>
			</list_content_framed_groupbox>
			<scrollbar_content_list />

			<resize_utilitybox />
		</sheetdata>
	</windowclass>
	<windowclass name="module_set_entry">
		<margins control="10,0,10,10" />
		<frame>fieldlight</frame>
		<script>
			local _vData;
			function setData(v)
				_vData = v;
				name.setValue(v and v.name);
			end
			function getData()
				return _vData;
			end
		</script>
		<sheetdata>
			<anchor_listitem_left_lg />
			<anchor_listitem_right_lg />

			<button_listitem_text_right_sm name="button_unload">
				<anchored width="60" />
				<state textres="module_unload" />
				<script>
					function onButtonPress()
						WindowManager.callOuterWindowFunction(window, "onModuleSetUnload", window.getData());
					end
				</script>
			</button_listitem_text_right_sm>
			<spacer_listitem_right>
				<anchored width="10" />
			</spacer_listitem_right>
			<button_listitem_text_right_sm name="button_load">
				<anchored width="60" />
				<state textres="module_load" />
				<script>
					function onButtonPress()
						WindowManager.callOuterWindowFunction(window, "onModuleSetLoad", window.getData());
					end
				</script>
			</button_listitem_text_right_sm>

			<label_listitem_center name="name" />
		</sheetdata>
	</windowclass>
	<windowclass name="module_set_load_entry">
		<margins control="10,0,10,10" />
		<frame>fieldlight</frame>
		<script>
			local _sProductID = "";
			function setData(tData, bLoad)
				if not tData then
					return;
				end
				_sProductID = tData.storeid or "";
				name.setValue(tData.displayname or tData.name);

				local sStatusIcon, sStatus;
				local info = Module.getModuleInfo(tData.name);
				if not info then
					if _sProductID ~= "" then
						button_shopping.setVisible(true);
					end
					sStatus = Session.IsHost and Interface.getString("module_state_not_installed") or Interface.getString("module_state_not_available");
				elseif not Session.IsHost and (info.permission == "disallow") then
					sStatus = Interface.getString("module_state_blocked");
				else
					if bLoad then
						if not info.loaded then
							Module.activate(tData.name);
						end
						sStatus = Interface.getString("module_state_loaded");
					else
						if info.loaded then
							Module.deactivate(tData.name);
						end
						sStatus = Interface.getString("module_state_unloaded");
					end
				end

				status.setValue(sStatus);
			end
			function onButtonShop()
				UtilityManager.sendToStoreDLCModule(_sProductID);
			end
		</script>
		<sheetdata>
			<anchor_listitem_left_lg />
			<anchor_listitem_right_lg />

			<button_listitem_icon_left name="button_shopping">
				<state icon="shopping" />
				<invisible />
				<script>
					function onButtonPress()
						window.onButtonShop();
					end
				</script>
			</button_listitem_icon_left>

			<label_listitem_right name="status">
				<anchored width="120" />
			</label_listitem_right>

			<stringc_listitem_center_noframe_static name="name" />
		</sheetdata>
	</windowclass>
</root>
