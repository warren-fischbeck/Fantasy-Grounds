<root>
	<windowclass name="charsheet_main">
		<script>
			function onInit()
				CharacterEngine.buildCharacter(getDatabaseNode());
			end
		</script>
		<margins control="0,0,0,2" />
		<sheetdata>
			<frame_char name="attributesframe">
				<bounds>0,0,-1,-70</bounds>
			</frame_char>
			<label_frametop>
				<anchored to="attributesframe" />
				<static textres="char_label_attributes" />
			</label_frametop>

			<alternating_windowlist name="char_attributes">
				<allowdelete />
				<anchored to="attributesframe">
					<left offset="15" />
					<top offset="35" />
					<right offset="-20" />
					<bottom offset="-20" />
				</anchored>
				<class>charsheet_main_attributes</class>
				<datasource>.attributes</datasource>
			</alternating_windowlist>

			<scrollbar_list>
				<anchored to="char_attributes" />
				<target>char_attributes</target>
			</scrollbar_list>

			<button_iedit name="char_attributes_iedit">
				<anchored to="char_attributes" position="aboveright" offset="-10,5" />
				<edittarget>char_attributes</edittarget>
			</button_iedit>
			<button_iadd name="char_attributes_iadd">
				<anchored to="char_attributes" position="aboveright" offset="10,5" />
				<target>char_attributes</target>
			</button_iadd>
		</sheetdata>
	</windowclass>
</root>