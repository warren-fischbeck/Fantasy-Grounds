<root>
	<windowclass name="starship_windowlist_weapon_item">
		<script>
			function onInit()
				self.onLockModeChanged(WindowManager.getWindowReadOnlyState(self));
			end

			function onLockModeChanged(bReadOnly)
				local tFields = { "weaponname",
				"weaponfirearc",
				"weaponskill",
				"weaponspecialization",
				"sfirecontrol",
				"weaponspacerange",
				"weaponatmosphererange",
				"weaponcrew",
				"weaponscale",
				"sweapondamage", };
				WindowManager.callSafeControlsSetLockMode(self, tFields, bReadOnly);
			end

			function firecontrol()
				local nodeFireControl = getDatabaseNode();
				Debug.console("firecontrol node: ",nodeFireControl);
				local sLabel = label_weaponfirecontrol.getValue();
				local aDice = DB.getValue(nodeFireControl, "dfirecontrol", 0);
				local nMod = DB.getValue(nodeFireControl, "nfirecontrol", 0);
				
				local rRoll = { sType = "dice", sDesc = sLabel, aDice = aDice, nMod = nMod };
				ActionsManager.performAction(draginfo, nil, rRoll);
				return true;
			end

			function weapondamage()
				local nodeWeaponDamage = getDatabaseNode();
				local sLabel = label_weapondamage.getValue();
				local aDice = DB.getValue(nodeWeaponDamage, "dweapondamage", 0);
				local nMod = DB.getValue(nodeWeaponDamage, "nweapondamage", 0);

				local rRoll = { sType = "dice", sDesc = sLabel, aDice = aDice, nMod = nMod };
				ActionsManager.performAction(draginfo, nil, rRoll);
				return true;
			end

			function updateDamage()
				local nodeWeaponDamage = getDatabaseNode();
				if not nodeWeaponDamage then
					return;
				end

				local sLabel = self.sweapondamage.getValue();
				local dDice, sMod = string.match(sLabel, "([^+]+)%+?(.*)");
				sMod = tonumber(sMod) or 0;
				dDice = string.lower(dDice);

				DB.setValue(nodeWeaponDamage, "dweapondamage", "dice", dDice);
				DB.setValue(nodeWeaponDamage, "nweapondamage", "number", sMod);
			end
			
			function updateFirecontrol()
				local nodeFireControl = getDatabaseNode();
				if not nodeFireControl then
					return;
				end

				local sLabel = self.sfirecontrol.getValue();
				local dDice, sMod = string.match(sLabel, "([^+]+)%+?(.*)");
				sMod = tonumber(sMod) or 0;
				dDice = string.lower(dDice);

				DB.setValue(nodeFireControl, "dfirecontrol", "dice", dDice);
				DB.setValue(nodeFireControl, "nfirecontrol", "number", sMod);
			end			
		</script>
