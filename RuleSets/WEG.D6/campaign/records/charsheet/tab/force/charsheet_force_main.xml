<root>
	<windowclass name="charsheet_force_main">
		<margins control="0,0,0,2" />
		<sheetdata>
			<anchor_listitem_left_sm />
			<anchor_listitem_right_sm />

			<frame_char name="forcemaster">
				<bounds>0,0,-10,40</bounds>
			</frame_char>
			<label_frametop name="label_character_master">
				<anchored to="forcemaster" />
				<static textres="label_forcemaster" />
			</label_frametop>
			<button_checkbox name="hasforcemaster" >
				<anchored to="label_character_master" height="30">
					<top  offset="-5" />
					<left parent="leftanchor" relation="right" />
					<right parent="rightanchor" relation="left" offset="-150" />
				</anchored>
			</button_checkbox>

			<frame_char name="forceframe">
				<bounds>0,45,-310,-75</bounds>
			</frame_char>
			<label_frametop>
				<anchored to="forceframe" />
				<static textres="label_ability_force" />
			</label_frametop>
			<list_core_force_abilities name="forcecorepowers">
				<anchored to="forceframe">
					<left offset="15" />
					<top offset="35" />
					<right offset="-20" />
					<bottom offset="-20" />
				</anchored>
				<datasource>.force.corepowers</datasource>
			</list_core_force_abilities>
			<scrollbar_list>
				<anchored to="forcecorepowers" />
				<target>forcecorepowers</target>
			</scrollbar_list>

			<button_iedit name="categories_iedit">
				<anchored to="forcecorepowers" position="aboveright" offset="-15,5" />
				<edittarget>forcecorepowers</edittarget>
			</button_iedit>
			<button_iadd name="categories_iadd">
				<anchored to="forcecorepowers" position="aboveright" offset="5,5" />
				<target>forcecorepowers</target>
			</button_iadd>

			<frame_char name="advancedforceframe">
				<bounds>-300,45,-10,-75</bounds>
			</frame_char>
			<label_frametop>
				<anchored to="advancedforceframe" />
				<static textres="label_ability_advancedforce" />
			</label_frametop>
			<list_advanced_force_abilities name="advancedabilities" >
				<anchored to="advancedforceframe">
					<left offset="15" />
					<top offset="35" />
					<right offset="-20" />
					<bottom offset="-20" />
				</anchored>
				<datasource>.force.advancedpowers</datasource>
			</list_advanced_force_abilities>
			<scrollbar_list>
				<anchored to="advancedabilities" />
				<target>advancedabilities</target>
			</scrollbar_list>

			<button_iedit name="advancedabilities_iedit">
				<anchored to="advancedabilities" position="aboveright" offset="-15,5" />
				<edittarget>advancedabilities</edittarget>
			</button_iedit>
			<button_iadd name="advancedabilities_iadd">
				<anchored to="advancedabilities" position="aboveright" offset="5,5" />
				<target>advancedabilities</target>
			</button_iadd>
		</sheetdata>
	</windowclass>

	<template name="list_advanced_force_abilities">
		<windowlist>
			<class>force_advanced_abilities</class>
			<datasource>.force.advancedpowers</datasource>
			<columns width="400" filldown="true" dynamic="true" />
			<sortby>
				<field>name</field>
			</sortby>
			<allowdelete />
		</windowlist>
	</template>

	<template name="list_core_force_abilities">
		<windowlist>
			<class>force_core_abilities</class>
			<datasource>.force.corepowers</datasource>
			<columns width="400" filldown="true" dynamic="true" />
			<sortby>
				<field>name</field>
			</sortby>
			<allowdelete />
		</windowlist>
	</template>
</root>