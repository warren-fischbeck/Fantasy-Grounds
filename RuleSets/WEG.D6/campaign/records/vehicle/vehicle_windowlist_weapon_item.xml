<root>
	<windowclass name="vehicle_windowlist_weapon_item">
		<script>
			function onInit()
				self.onLockModeChanged(WindowManager.getWindowReadOnlyState(self));
			end

			function onLockModeChanged(bReadOnly)
				local tFields = { "weaponname", 
					"weaponfirearc",
					"weaponspecialization",
					"sfirecontrol",
					"weaponrange",
					"sweapondamage",
					"weaponskill", };
				WindowManager.callSafeControlsSetLockMode(self, tFields, bReadOnly);
				divider2.setVisible(WindowManager.getAnyControlVisible(self, { "type", }));
				divider3.setVisible(WindowManager.getAnyControlVisible(self, { "notes", }));
			end
			function firecontrol()
				local nodeFireControl = getDatabaseNode();
				Debug.console("firecontrol node: ",nodeFireControl);
				local sLabel = label_weaponfirecontrol.getValue();
				local aDice = DB.getValue(nodeFireControl, "dfirecontrol", 0); 
				local nMod = DB.getValue(nodeFireControl, "nfirecontrol", 0);

				local rRoll = { sType = "dice", sDesc = sLabel, aDice = aDice, nMod = nMod };
				ActionsManager.performAction(draginfo, nil, rRoll);
				return true;
			end

			function weapondamage()
				local nodeWeaponDamage = getDatabaseNode();
				local sLabel = label_weapondamage.getValue();
				local aDice = DB.getValue(nodeWeaponDamage, "dweapondamage", 0);
				local nMod = DB.getValue(nodeWeaponDamage, "nweapondamage", 0);
				
				local rRoll = { sType = "dice", sDesc = sLabel, aDice = aDice, nMod = nMod };
				ActionsManager.performAction(draginfo, nil, rRoll);
				return true;
			end
			
		</script>
		<sheetdata>
			<stringcontrol name="label_weaponname">
				<anchored>
					<top offset="5" />
					<left offset="25" />
				</anchored>
				<font>sheetlabel</font>
				<static textres="vehicle_label_weaponname" />
			</stringcontrol>
			<stringfield name="weaponname">
				<anchored>
					<top offset="5" />
					<left offset="120" />
					<right offset="-90" />
				</anchored>
				<stateframe>
					<keyedit name="fieldfocus" offset="7,5,7,5" />
					<hover name="fieldfocus" offset="7,5,7,5" hidereadonly="true" />
					<drophilight name="fieldfocus" offset="7,5,7,5" hidereadonly="true" />
				</stateframe>
				<multilinespacing>20</multilinespacing>
				<left />
			</stringfield>

			<stringcontrol name="label_weapaonfirearc">
				<anchored>
					<top offset="25" />
					<left offset="35" />
				</anchored>
