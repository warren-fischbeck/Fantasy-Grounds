<root>
	<windowclass name="charsheet_combat_weapon_item">
		<margins control="0,0,0,2" />
		<sheetdata>
			<anchor_base_left />
			<anchor_base_right />
			<stringcontrol name="label">
				<anchored>
					<top offset="0" />
					<left parent="leftanchor" position="right" offset="100" />
				</anchored>
				<static text="Weapon :" />
			</stringcontrol>
			<stringfield name="itemname">
				<anchored>
					<top offset="0" />
					<right relation="current" />
					<left relation="current" offset="0" />
				</anchored>
				<font>reference-b</font>
			</stringfield>
			<stringfield name="itemskill">
				<anchored>
					<top offset="0" />
					<right relation="current" />
					<left relation="current" offset="0" />
				</anchored>
				<font>reference-b</font>
			</stringfield>
			<stringfield name="itemtype">
				<anchored>
					<top offset="0" />
					<right relation="current" />
					<left relation="current" offset="0" />
				</anchored>
				<font>reference-b</font>
			</stringfield>
		</sheetdata>
	</windowclass>
</root>