<root>
	<windowclass name="starship" copy="record_window_tabbed">
		<minimize>minimized_item</minimize>
		<tab>
			<name>main</name>
			<resource>tab_main</resource>
			<class>starship_main</class>
			<embed />
		</tab>
		<tab merge="add">
			<name>weapons</name>
			<resource>tab_weapons</resource>
			<class>starship_weapons</class>
			<embed />
		</tab>
		<tab merge="add">
			<name>pictures</name>
			<resource>tab_pictures</resource>
			<class>record_content_pictures</class>
			<embed />
		</tab>
	</windowclass>
	<windowclass name="starship_header" copy="record_header" />
</root>
